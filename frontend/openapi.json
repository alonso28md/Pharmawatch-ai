{
  "openapi": "3.1.0",
  "info": {
    "title": "PharmaWatch AI",
    "description": "AI-powered pharmacovigilance assistant for medical device adverse event classification and regulatory reporting. Combines a RAG pipeline over real MDR 2017/745 and AEMPS regulatory text with a LangGraph incident-classification agent, backed by a reproducible evaluation harness.",
    "version": "2.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Report service status, vector store connectivity, and configured model.\n\nA plain `def`: FastAPI runs it in the threadpool, so the (blocking) vector-store and\nDB checks never stall the event loop.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "tags": [
          "rag"
        ],
        "summary": "Ask",
        "description": "Answer a regulatory question with citations from the indexed documents.",
        "operationId": "ask_ask_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/report": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Report",
        "description": "Classify an adverse event description and determine its reporting requirements.\n\nEvery classified incident is persisted (without its free-text description) and can\nbe fetched again with GET /reports/{incident_id}.",
        "operationId": "report_report_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/report/stream": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Report Stream",
        "description": "Same as POST /report, streamed as server-sent events.\n\nEvents: `step` {\"node\", \"index\"} each time a LangGraph node finishes (the graph's own\nupdate events, in order); then `result` (a ReportResponse) or `error`\n{\"code\", \"message\"}. Validation and auth errors are returned before the stream starts.",
        "operationId": "report_stream_report_stream_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-sent events",
            "content": {
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reports": {
      "get": {
        "tags": [
          "agent"
        ],
        "summary": "List Reports",
        "description": "Stored incident results, newest first, with optional filters.",
        "operationId": "list_reports_reports_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "serious",
                    "non-serious"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Severity"
            }
          },
          {
            "name": "escalation",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "none",
                    "advisory",
                    "blocking",
                    "escalated"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Escalation"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive, UTC calendar day",
              "title": "Date From"
            },
            "description": "Inclusive, UTC calendar day"
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive, UTC calendar day",
              "title": "Date To"
            },
            "description": "Inclusive, UTC calendar day"
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reports/{incident_id}": {
      "get": {
        "tags": [
          "agent"
        ],
        "summary": "Get Report",
        "description": "Return the stored classification result for `incident_id`.",
        "operationId": "get_report_reports__incident_id__get",
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^INC-\\d{4}-[0-9A-F]{6,8}$",
              "title": "Incident Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/evaluate": {
      "post": {
        "tags": [
          "evaluation"
        ],
        "summary": "Evaluate",
        "description": "Run the golden-dataset evaluation harness (real model calls; takes minutes).\n\nOnly dataset names from the EVALUATION_DATASETS whitelist are accepted. The\nerror for an unknown name is the same whether or not a file by that name exists.\nResults are written as JSON to ARTIFACTS_DIR - never to docs/ or the query DB.",
        "operationId": "evaluate_evaluate_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/evaluations/latest": {
      "get": {
        "tags": [
          "evaluation"
        ],
        "summary": "Latest Evaluation",
        "description": "Metrics of the latest stored evaluation run, with thresholds and min/max over repetitions.\n\nRead-only: it reads JSON files in ARTIFACTS_DIR/evaluations and never calls the model.\nPer-case results are not included.",
        "operationId": "latest_evaluation_evaluations_latest_get",
        "parameters": [
          {
            "name": "dataset",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,40}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dataset label, e.g. v2",
              "title": "Dataset"
            },
            "description": "Dataset label, e.g. v2"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationLatest"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "observability"
        ],
        "summary": "Operational Metrics",
        "description": "Aggregate business-request metrics (/ask, /report, /evaluate) from the SQLite query log.",
        "operationId": "operational_metrics_metrics_get",
        "parameters": [
          {
            "name": "include_demo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Include synthetic rows written by scripts/seed_db.py",
              "default": false,
              "title": "Include Demo"
            },
            "description": "Include synthetic rows written by scripts/seed_db.py"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationalMetricsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/config": {
      "get": {
        "tags": [
          "observability"
        ],
        "summary": "Config",
        "description": "Expose non-secret capabilities/limits so a future client can configure itself.",
        "operationId": "config_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 10,
            "title": "Question"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "en",
                  "es"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "description": "POST /ask request body. `language` forces the answer language; omitted = auto-detect."
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "retrieval_score": {
            "type": "number",
            "title": "Retrieval Score"
          },
          "processing_time_ms": {
            "type": "integer",
            "title": "Processing Time Ms"
          },
          "context": {
            "items": {
              "$ref": "#/components/schemas/ContextChunk"
            },
            "type": "array",
            "title": "Context",
            "default": []
          },
          "cited_labels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Cited Labels",
            "default": []
          },
          "answered_from_context": {
            "type": "boolean",
            "title": "Answered From Context",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "answer",
          "sources",
          "retrieval_score",
          "processing_time_ms"
        ],
        "title": "AskResponse",
        "description": "POST /ask response body."
      },
      "ConfigResponse": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model"
          },
          "rate_limit_per_minute": {
            "type": "integer",
            "title": "Rate Limit Per Minute"
          },
          "retrieval_top_k": {
            "type": "integer",
            "title": "Retrieval Top K"
          },
          "supported_languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Supported Languages"
          },
          "endpoints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Endpoints"
          }
        },
        "type": "object",
        "required": [
          "model",
          "rate_limit_per_minute",
          "retrieval_top_k",
          "supported_languages",
          "endpoints"
        ],
        "title": "ConfigResponse",
        "description": "GET /config response body: capabilities/limits a future client can rely on."
      },
      "ContextChunk": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "document": {
            "type": "string",
            "title": "Document"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "label",
          "chunk_id",
          "document",
          "section",
          "text"
        ],
        "title": "ContextChunk",
        "description": "One retrieved chunk as given to the model, with its citation label."
      },
      "EvaluateRequest": {
        "properties": {
          "dataset": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,40}$",
            "title": "Dataset",
            "default": "default"
          },
          "categories": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "enum": [
                    "rag",
                    "classification"
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Categories"
          }
        },
        "type": "object",
        "title": "EvaluateRequest",
        "description": "POST /evaluate request body. `dataset` is a whitelisted name, never a path."
      },
      "EvaluateResponse": {
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/EvaluationSummary"
          },
          "metrics": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Metrics"
          },
          "failed_cases": {
            "items": {
              "$ref": "#/components/schemas/FailedCase"
            },
            "type": "array",
            "title": "Failed Cases"
          },
          "report_file": {
            "type": "string",
            "title": "Report File"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "metrics",
          "failed_cases",
          "report_file",
          "timestamp"
        ],
        "title": "EvaluateResponse",
        "description": "POST /evaluate response body. `report_file` lives in ARTIFACTS_DIR/evaluations/."
      },
      "EvaluationLatest": {
        "properties": {
          "file": {
            "type": "string",
            "title": "File"
          },
          "rescored": {
            "type": "boolean",
            "title": "Rescored"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          },
          "summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Summary"
          },
          "metric_summary": {
            "additionalProperties": {
              "$ref": "#/components/schemas/MetricStat"
            },
            "type": "object",
            "title": "Metric Summary"
          },
          "failed_cases": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Failed Cases"
          }
        },
        "type": "object",
        "required": [
          "file",
          "rescored",
          "timestamp",
          "metadata",
          "summary",
          "metric_summary",
          "failed_cases"
        ],
        "title": "EvaluationLatest",
        "description": "GET /evaluations/latest: a stored evaluation result (read-only, never runs one)."
      },
      "EvaluationSummary": {
        "properties": {
          "total_cases": {
            "type": "integer",
            "title": "Total Cases"
          },
          "passed": {
            "type": "integer",
            "title": "Passed"
          },
          "failed": {
            "type": "integer",
            "title": "Failed"
          },
          "pass_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pass Rate"
          }
        },
        "type": "object",
        "required": [
          "total_cases",
          "passed",
          "failed",
          "pass_rate"
        ],
        "title": "EvaluationSummary",
        "description": "Summary block of an /evaluate response."
      },
      "FailedCase": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "case_id"
        ],
        "title": "FailedCase",
        "description": "A single failed case in an /evaluate response."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded"
            ],
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "vectorstore": {
            "type": "string",
            "enum": [
              "connected",
              "unavailable"
            ],
            "title": "Vectorstore"
          },
          "vectorstore_documents": {
            "type": "integer",
            "title": "Vectorstore Documents"
          },
          "database": {
            "type": "string",
            "enum": [
              "connected",
              "unavailable"
            ],
            "title": "Database"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "uptime_seconds": {
            "type": "number",
            "title": "Uptime Seconds"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "vectorstore",
          "vectorstore_documents",
          "database",
          "model",
          "uptime_seconds"
        ],
        "title": "HealthResponse",
        "description": "GET /health response body."
      },
      "IncidentPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/IncidentSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
