# Anthropic Claude API key (required to run RAG / agent / evaluation)
ANTHROPIC_API_KEY=

# Claude model id used across the system
ANTHROPIC_MODEL=claude-sonnet-5-5

# Logging
LOG_LEVEL=INFO

# Storage
DB_PATH=data/pharmawatch.db
CHROMA_PERSIST_DIR=data/chroma_db

# RAG chunking / retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5

# API
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Without API_KEY, /ask and /report are disabled unless DEMO_MODE=true; /evaluate always needs API_KEY.
API_KEY=
DEMO_MODE=false
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=64000

# Evaluation: whitelisted datasets (name=file under data/) and output directory for JSON results
EVALUATION_DATASETS=default=golden_dataset.json,v2=golden_dataset_v2.json
ARTIFACTS_DIR=artifacts

# Model client
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Embeddings (changing it requires re-running scripts/ingest_documents.py)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Optional independent reviewer node (empty REVIEWER_MODEL = same as ANTHROPIC_MODEL)
REVIEWER_ENABLED=false
REVIEWER_MODEL=

# Evaluation LLM judge (empty = same as ANTHROPIC_MODEL)
EVAL_JUDGE_MODEL=
